DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dispatch
CRM_API_URL=http://localhost:8001
# demo = role picker, no passwords (public demo only) · password = real sign-in
AUTH_MODE=demo
# Optional — without it the copilot quotes SOP sections and plans with SOP rules
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
